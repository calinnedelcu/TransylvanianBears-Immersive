{
  "name": "transylvanian-bears-experience",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:buried-assets && tsc -b && vite build",
    "lint": "eslint .",
    "qa:immersive": "node scripts/qa-immersive.mjs",
    "qa:school-act": "node scripts/qa-school-act.mjs",
    "qa:buried-act": "node scripts/qa-buried-act.mjs",
    "check:buried-assets": "node scripts/check-buried-assets.mjs",
    "qa:visual": "node scripts/qa-visual.mjs",
    "preview": "vite preview",
    "build:cameras": "blender --background --python-exit-code 1 --python scripts/blender/build_vertical_slice_cameras.py",
    "build:buried-act:cameras": "blender --background --python-exit-code 1 --python scripts/blender/build_buried_act_cameras.py",
    "build:buried-act:model": "blender --background --python-exit-code 1 --python scripts/blender/build_buried_act.py",
    "build:buried-act:media": "node scripts/build-buried-media.mjs",
    "build:buried-act": "npm run build:buried-act:media && npm run build:buried-act:model && npm run build:buried-act:cameras",
    "build:first-light": "blender --background --python-exit-code 1 --python scripts/blender/build_first_light.py && gltf-transform optimize public/assets/world/first-light-citadel.raw.glb public/assets/world/first-light-citadel.glb --compress meshopt --palette false --texture-compress false && npm run build:first-light:desktop && npm run build:first-light:mobile && node scripts/convert-first-light-poster.mjs",
    "build:first-light:desktop": "node scripts/build-first-light-mobile.mjs desktop",
    "build:first-light:mobile": "node scripts/build-first-light-mobile.mjs mobile",
    "build:vertical-slice": "npm run build:cameras && npm run build:first-light && npm run build:buried-act",
    "optimize:images": "node scripts/optimize-images.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@xstate/react": "^6.1.0",
    "autoprefixer": "^10.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.470.0",
    "postcss": "^8.5.12",
    "postprocessing": "^6.39.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "three": "0.182.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@gltf-transform/cli": "^4.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "playwright": "^1.61.1",
    "sharp": "^0.34.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.1.4"
  }
}
