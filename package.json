{
  "name": "transylvanian-bears-experience",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:first-light": "blender --background --python-exit-code 1 --python scripts/blender/build_first_light.py && gltf-transform optimize public/assets/world/first-light-citadel.raw.glb public/assets/world/first-light-citadel.glb --compress meshopt --palette false --texture-compress false && node scripts/convert-first-light-poster.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@xstate/react": "^6.1.0",
    "autoprefixer": "^10.5.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.470.0",
    "postcss": "^8.5.12",
    "postprocessing": "^6.39.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "three": "0.182.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@gltf-transform/cli": "^4.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "playwright": "^1.61.1",
    "sharp": "^0.34.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.1.4"
  }
}
